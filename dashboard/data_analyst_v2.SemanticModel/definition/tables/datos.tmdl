	/// Rango de 25 puntos del puntaje global, para ver la distribucion por zona.
	column rango_global = INT(datos[global] / 25) * 25
		dataType: int64
		formatString: 0
		lineageTag: 2b4e79e9-2f6c-99bd-3d20-fa9a8cbd323f
		summarizeBy: none

		annotation SummarizationSetBy = User

	partition datos = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos), [Delimiter = ",", Columns = 12, Encoding = 65001, QuoteStyle = QuoteStyle.None]),
				    #"Encabezados promovidos" = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"Encabezados promovidos", {{"genero", type text}, {"zona", type text}, {"depto", type text}, {"municipio", type text}, {"estrato", type text}, {"educacion_madre", type text}, {"educacion_padre", type text}, {"internet", type text}, {"matematicas", Int64.Type}, {"lectura", Int64.Type}, {"global", Int64.Type}, {"periodo", Int64.Type}})
				in
				    #"Tipo cambiado"

	annotation PBI_ResultType = Table
