                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1. Conectividad rural con acompañamiento pedagógico. ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1F2937",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "El internet se asocia con +36 puntos, pero solo no cierra la brecha: entre quienes lo tienen sigue en 28,6 puntos.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1F2937",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2. Focalizar a los estudiantes rurales de estratos 2 y 3, ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1F2937",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "donde la brecha es mayor (32,2 y 48,1 puntos).",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1F2937",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3. Intervenir lectura y matemáticas por igual: ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1F2937",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "la brecha es parecida en las dos (0,56 y 0,48 desviaciones estándar).",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1F2937",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "4. Seguir la brecha por estrato, no solo el promedio general, ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1F2937",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "con una meta inicial de menos de 20 puntos.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1F2937",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "5. Mejorar la calidad del dato: ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1F2937",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "14,7 % no informó internet y 15,5 % no informó estrato.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1F2937",
                      "fontFamily": "Segoe UI"
