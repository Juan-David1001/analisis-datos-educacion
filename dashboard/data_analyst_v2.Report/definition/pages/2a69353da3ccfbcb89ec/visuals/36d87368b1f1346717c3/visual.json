                      "color": "#1F2937",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "La brecha es real y relevante. ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1F2937",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "28,7 puntos a favor de lo urbano (d = 0,55, efecto mediano). La nacional es 26,2.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1F2937",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "El internet tiene el mayor efecto: ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1F2937",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "+36 puntos (d = 0,70)…",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1F2937",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "…pero no cierra la brecha. ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1F2937",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Entre quienes tienen internet sigue en 28,6 puntos.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1F2937",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "No es solo el estrato. ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1F2937",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Dentro del mismo estrato la brecha crece: 15,8 en estrato 1 y 48,1 en estrato 3.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1F2937",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Muestra algo por debajo del país: ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1F2937",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "−3,2 puntos en el global y −5,3 pp en internet.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1F2937",
                      "fontFamily": "Segoe UI"
                    }
